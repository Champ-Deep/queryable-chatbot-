// Cloudflare Workers + Containers deployment of the Champions A2A demo.
// Deploy: npx wrangler deploy   (Docker must be running; Workers Builds can build it too)
// Lab password: npx wrangler secret put LAB_PASSWORD
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queryable-chatbot",
  "main": "worker/index.js",
  "account_id": "ae03bce34fb2cd34756be0003196572f",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ChampionsDemo",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CHAMPIONS_DEMO", "class_name": "ChampionsDemo" }]
  },
  "exports": {
    "ChampionsDemo": { "type": "durable-object", "storage": "sqlite" }
  }
}
