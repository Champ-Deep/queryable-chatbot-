# Optional configuration. Every value has a working local default.
# Never commit a real .env file (it is git-ignored).

# HS256 key that signs OAuth tokens (default: random per process)
CHAMPIONS_SIGNING_KEY=

# Internal key for the REST API /api/v1, held only by the MCP server (default: random per process)
CHAMPIONS_API_KEY=

# Point the MCP tools at a remote/real REST API instead of this process
CHAMPIONS_API_URL=

# SQLite query-log location (default: data/query_log.db)
CHAMPIONS_QUERY_LOG=

# Where the Personal Agent reaches the Champions agent
CHAMPIONS_URL=http://127.0.0.1:9100

# OAuth client credentials of the Personal Agent (change outside local demos)
PERSONAL_AGENT_CLIENT_ID=personal-agent-demo
PERSONAL_AGENT_CLIENT_SECRET=demo-secret-change-me
